{
  "name": "personalinvoice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "e2e": "node e2e/full-flow.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "db:local": "node supabase/local/keys.mjs && docker compose -f supabase/local/docker-compose.yml --env-file supabase/local/.env up -d",
    "db:gateway": "node supabase/local/gateway.mjs",
    "cert:generate": "tsx scripts/generate-signing-cert.ts",
    "etax:validate": "python3 scripts/validate-etax.py",
    "etax:geo": "node scripts/build-etax-geo.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@react-pdf/renderer": "^4.9.0",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "16.3.7",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.63.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
