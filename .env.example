# Supabase (hosted project, or http://localhost:54321 + the local ANON_KEY from supabase/local/.env)
NEXT_PUBLIC_SUPABASE_URL=https://coqplrqyqvqlkgmqzvuc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public site URL, printed in the verification link on issued documents
APP_URL=https://your-app.example.com
# Where headless Chromium reaches this app to render PDFs (defaults to http://127.0.0.1:$PORT)
# INTERNAL_APP_URL=http://127.0.0.1:3000

# Document signing certificate: `npm run cert:generate -- "Your Business Name"` prints both values
SIGNING_P12_BASE64=
SIGNING_P12_PASSPHRASE=

# e-Tax packages: certificate issued by a Thai CA (see docs/PHASE2-ETAX.md). Without it, e-Tax packages are signed
# with the certificate above and labelled as test packages.
ETAX_SIGNING_P12_BASE64=
ETAX_SIGNING_P12_PASSPHRASE=

# Optional: Chromium binary if Playwright's bundled browser isn't installed
# CHROMIUM_PATH=/path/to/chrome

# Billing test mode: lets the checkout simulate a successful payment. Works only when the database holds the same
# value: insert into private.billing_config (id, test_secret) values (1, '<secret>'). Leave unset in production
# until a real payment provider is connected; the checkout then says online payment isn't switched on yet.
# BILLING_TEST_SECRET=

# Opn Payments (Omise). With all three set, the checkout takes real PromptPay and card payments (test keys: no money
# moves, and the PromptPay page offers a "simulate paying" button). BILLING_PROVIDER_SECRET must match the database:
# update private.billing_config set provider_secret = '<secret>' (insert the row with id 1 if there is none).
# Register https://<your domain>/api/omise/webhook as the webhook endpoint in the Opn dashboard.
# OMISE_PUBLIC_KEY=pkey_test_...
# OMISE_SECRET_KEY=skey_test_...
# BILLING_PROVIDER_SECRET=

# Receipts/tax invoices for subscriptions are issued from the seller account set in the database:
# update private.billing_config set seller_owner_id = '<your user id>'. Leave it unset while the Opn keys are test
# keys, so test payments don't use up real tax invoice numbers.

# Operator details printed in the terms and privacy notice and used for data requests. Until all four are set the
# terms page says it is not in force yet.
# OPERATOR_NAME=
# OPERATOR_TAX_ID=
# OPERATOR_ADDRESS=
# CONTACT_EMAIL=
